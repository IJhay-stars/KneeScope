{
  "$defs": {
    "DataOrigin": {
      "description": "Where a study or artifact came from.",
      "enum": [
        "fixture",
        "dataset"
      ],
      "title": "DataOrigin",
      "type": "string"
    },
    "DatasetLabel": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/LabelProvenance"
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where the label came from, e.g. 'train.csv' or 'rules v0.2'.",
          "title": "Source Ref"
        },
        "state": {
          "$ref": "#/$defs/LabelState"
        }
      },
      "required": [
        "finding_id",
        "state",
        "provenance"
      ],
      "title": "DatasetLabel",
      "type": "object"
    },
    "LabelProvenance": {
      "enum": [
        "expert_annotation",
        "dataset_provided",
        "report_extracted",
        "fixture"
      ],
      "title": "LabelProvenance",
      "type": "string"
    },
    "LabelState": {
      "enum": [
        "positive",
        "negative",
        "unknown",
        "not_labeled"
      ],
      "title": "LabelState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dataset_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Dataset Id"
    },
    "labels": {
      "items": {
        "$ref": "#/$defs/DatasetLabel"
      },
      "title": "Labels",
      "type": "array"
    },
    "notice": {
      "default": "Dataset labels are for evaluation only. They are never used by the model.",
      "title": "Notice",
      "type": "string"
    },
    "origin": {
      "$ref": "#/$defs/DataOrigin"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "study_id": {
      "title": "Study Id",
      "type": "string"
    }
  },
  "required": [
    "study_id",
    "dataset_id",
    "origin",
    "labels"
  ],
  "title": "StudyLabels",
  "type": "object"
}
