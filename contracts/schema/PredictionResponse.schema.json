{
  "$defs": {
    "FindingResult": {
      "additionalProperties": false,
      "properties": {
        "above_threshold": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Above Threshold"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "explanation_available": {
          "default": false,
          "title": "Explanation Available",
          "type": "boolean"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "score_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScoreKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/FindingStatus"
        },
        "threshold": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Validated operating threshold, if one exists.",
          "title": "Threshold"
        }
      },
      "required": [
        "finding_id",
        "display_name",
        "status"
      ],
      "title": "FindingResult",
      "type": "object"
    },
    "FindingStatus": {
      "enum": [
        "scored",
        "not_evaluated",
        "unavailable",
        "unsupported",
        "failed"
      ],
      "title": "FindingStatus",
      "type": "string"
    },
    "InputUsage": {
      "additionalProperties": false,
      "properties": {
        "plane": {
          "$ref": "#/$defs/Plane"
        },
        "series_id": {
          "title": "Series Id",
          "type": "string"
        },
        "slices_used": {
          "minimum": 0,
          "title": "Slices Used",
          "type": "integer"
        }
      },
      "required": [
        "plane",
        "series_id",
        "slices_used"
      ],
      "title": "InputUsage",
      "type": "object"
    },
    "ModelInfo": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "SHA-256 of the checkpoint file. None only for fixtures.",
          "title": "Checkpoint Sha256"
        },
        "finding_profile": {
          "title": "Finding Profile",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "supported_findings": {
          "items": {
            "type": "string"
          },
          "title": "Supported Findings",
          "type": "array"
        },
        "trained_on": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dataset ID and partition; None for fixtures.",
          "title": "Trained On"
        }
      },
      "required": [
        "model_id",
        "model_version",
        "checkpoint_sha256",
        "finding_profile",
        "supported_findings",
        "trained_on"
      ],
      "title": "ModelInfo",
      "type": "object"
    },
    "Plane": {
      "enum": [
        "sagittal",
        "coronal",
        "axial"
      ],
      "title": "Plane",
      "type": "string"
    },
    "PreprocessingInfo": {
      "additionalProperties": false,
      "properties": {
        "config_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Sha256"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version"
      ],
      "title": "PreprocessingInfo",
      "type": "object"
    },
    "Reason": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "Machine-readable code, usually an ErrorCode value.",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "description": "Plain-language explanation safe to show to a reviewer.",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Reason",
      "type": "object"
    },
    "ResultProvenance": {
      "additionalProperties": false,
      "properties": {
        "cache_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Key"
        },
        "computed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "When the scores were originally computed.",
          "title": "Computed At"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Wall time of this live run; only for source=live.",
          "title": "Latency Ms"
        },
        "notice": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notice"
        },
        "served_at": {
          "format": "date-time",
          "title": "Served At",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ResultSource"
        }
      },
      "required": [
        "source",
        "computed_at",
        "served_at"
      ],
      "title": "ResultProvenance",
      "type": "object"
    },
    "ResultSource": {
      "description": "How a prediction was produced. Never relabel one as another.",
      "enum": [
        "live",
        "cached",
        "fixture"
      ],
      "title": "ResultSource",
      "type": "string"
    },
    "ScoreKind": {
      "enum": [
        "uncalibrated_model_score",
        "calibrated_probability"
      ],
      "title": "ScoreKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "findings": {
      "items": {
        "$ref": "#/$defs/FindingResult"
      },
      "title": "Findings",
      "type": "array"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/InputUsage"
      },
      "title": "Inputs",
      "type": "array"
    },
    "missing_planes": {
      "items": {
        "$ref": "#/$defs/Plane"
      },
      "title": "Missing Planes",
      "type": "array"
    },
    "model": {
      "$ref": "#/$defs/ModelInfo"
    },
    "prediction_id": {
      "title": "Prediction Id",
      "type": "string"
    },
    "preprocessing": {
      "$ref": "#/$defs/PreprocessingInfo"
    },
    "provenance": {
      "$ref": "#/$defs/ResultProvenance"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "study_id": {
      "title": "Study Id",
      "type": "string"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/Reason"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "prediction_id",
    "study_id",
    "provenance",
    "model",
    "preprocessing",
    "findings",
    "inputs",
    "missing_planes"
  ],
  "title": "PredictionResponse",
  "type": "object"
}
